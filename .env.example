# PostgreSQL (Neon) connection string.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Panel admin: password login dan kunci penandatangan cookie sesi.
# Buat AUTH_SECRET dengan: openssl rand -base64 32
ADMIN_PASSWORD="ganti-dengan-password-kuat"
AUTH_SECRET="ganti-dengan-hasil-openssl-rand"

# Opsional: domain kanonik situs.
# NEXT_PUBLIC_SITE_URL="https://nadaupacarabali.com"
